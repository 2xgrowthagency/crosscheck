{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2xgrowthagency.github.io/crosscheck/schemas/crosscheck-receipt-1.1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "target_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "criterion_totals": {
      "type": "object",
      "properties": {
        "required": {"$ref": "#/$defs/totals"},
        "advisory": {"$ref": "#/$defs/totals"}
      },
      "required": ["required", "advisory"],
      "additionalProperties": false
    },
    "verifier_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "gate_cleared": {
      "type": "boolean"
    },
    "meaning": {
      "type": "string",
      "minLength": 1
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "criterion_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error"
            ]
          },
          "disposition": {
            "enum": [
              "rework",
              "ask-owner"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "criterion_id",
          "owner",
          "action",
          "severity",
          "disposition",
          "observation",
          "artifact_ids",
          "impact"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "publication": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "destination_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "status": {
            "enum": [
              "pending",
              "not-authorized",
              "published",
              "failed",
              "stale"
            ]
          },
          "comment_locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "destination_id",
          "status",
          "comment_locator",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "target_sha256",
    "manifest_sha256",
    "report_sha256",
    "criterion_totals",
    "verifier_id",
    "evaluated_at",
    "expires_at",
    "verdict",
    "gate_cleared",
    "meaning",
    "problems",
    "publication"
  ],
  "additionalProperties": false,
  "$defs": {
    "totals": {
      "type": "object",
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}
      },
      "required": ["total", "passed", "failed", "blocked"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "gate_cleared": {
            "const": true
          },
          "problems": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "gate_cleared": {
            "const": false
          },
          "problems": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
